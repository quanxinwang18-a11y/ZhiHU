.page-shell {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  background:
    radial-gradient(circle at 50% 28%, rgba(154, 112, 55, 0.1), transparent 35%),
    radial-gradient(circle at 10% 78%, rgba(66, 83, 75, 0.1), transparent 30%),
    #070707;
}

.star-field,
.ambient {
  position: fixed;
  z-index: 0;
  pointer-events: none;
}

.star-field {
  inset: 0;
  opacity: 0.55;
}

.star {
  position: absolute;
  width: 3rpx;
  height: 3rpx;
  border-radius: 50%;
  background: #ddc99f;
  box-shadow: 0 0 12rpx rgba(221, 201, 159, 0.55);
  animation: star-breathe 4.5s ease-in-out infinite;
}

.star-one {
  top: 14%;
  left: 12%;
}

.star-two {
  top: 23%;
  right: 18%;
  animation-delay: -1.4s;
}

.star-three {
  top: 48%;
  left: 7%;
  animation-delay: -2.8s;
}

.star-four {
  top: 62%;
  right: 9%;
  animation-delay: -0.8s;
}

.star-five {
  top: 78%;
  left: 22%;
  animation-delay: -3.7s;
}

.star-six {
  top: 88%;
  right: 28%;
  animation-delay: -2.1s;
}

.ambient {
  width: 440rpx;
  height: 440rpx;
  border-radius: 50%;
  filter: blur(76rpx);
  opacity: 0.12;
}

.ambient-one {
  top: 160rpx;
  right: -300rpx;
  background: #d2a761;
}

.ambient-two {
  top: 1080rpx;
  left: -320rpx;
  background: #54675d;
}

.topbar,
.content {
  position: relative;
  z-index: 2;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-right: 28rpx;
  padding-bottom: 18rpx;
  padding-left: 28rpx;
}

.brand {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 0;
  padding: 8rpx 0;
  line-height: 1;
  text-align: left;
  background: transparent;
}

.brand-mark {
  display: flex;
  width: 54rpx;
  height: 54rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(226, 199, 146, 0.42);
  border-radius: 16rpx 16rpx 4rpx 16rpx;
  color: #dfc58e;
  font-family: "STSong", serif;
  font-size: 27rpx;
  background: rgba(226, 199, 146, 0.035);
}

.brand-name,
.brand-caption {
  display: block;
}

.brand-name {
  color: #ece3d5;
  font-family: "STSong", serif;
  font-size: 28rpx;
  letter-spacing: 5rpx;
}

.brand-caption {
  margin-top: 7rpx;
  color: #625d55;
  font-size: 14rpx;
  letter-spacing: 2.5rpx;
}

.history-button {
  width: 58rpx;
  height: 58rpx;
  margin: 0;
  padding: 0;
  border: 1rpx solid rgba(220, 197, 155, 0.12);
  border-radius: 50%;
  color: #8f816c;
  font-size: 25rpx;
  line-height: 58rpx;
  background: rgba(255, 255, 255, 0.015);
}

.content {
  padding: 8rpx 0 72rpx;
}

.hero {
  padding: 54rpx 36rpx 22rpx;
}

.eyebrow-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.eyebrow,
.section-kicker,
.session-kicker,
.synthesis-label,
.reading-kicker,
.reading-section-label {
  color: #92754a;
  font-size: 16rpx;
  letter-spacing: 4rpx;
}

.mode-chip {
  padding: 7rpx 13rpx;
  border: 1rpx solid rgba(210, 167, 97, 0.18);
  border-radius: 999rpx;
  color: #80745f;
  font-size: 17rpx;
}

.hero-title {
  display: block;
  color: #eee5d9;
  font-family: "STSong", serif;
  font-size: 58rpx;
  font-weight: 400;
  line-height: 1.35;
  letter-spacing: 2rpx;
}

.hero-title-indent {
  padding-left: 54rpx;
}

.hero-description {
  display: block;
  max-width: 630rpx;
  margin-top: 28rpx;
  color: #777169;
  font-size: 24rpx;
  line-height: 1.8;
}

.question-stage {
  padding: 28rpx 32rpx 64rpx;
  text-align: center;
}

.question-panel,
.exit-panel,
.synthesis-card,
.interrupted-panel {
  border: 1rpx solid rgba(228, 210, 178, 0.11);
  background:
    linear-gradient(145deg, rgba(31, 29, 26, 0.85), rgba(15, 15, 14, 0.94));
  box-shadow: 0 28rpx 90rpx rgba(0, 0, 0, 0.3);
}

.question-panel {
  padding: 28rpx;
  border-radius: 5rpx 30rpx 5rpx 5rpx;
  text-align: left;
}

.question-input {
  box-sizing: border-box;
  width: 100%;
  height: 250rpx;
  padding: 8rpx 3rpx;
  color: #eae1d5;
  font-family: "STSong", serif;
  font-size: 29rpx;
  line-height: 1.72;
}

.question-placeholder {
  color: #504c46;
}

.question-meta {
  display: flex;
  justify-content: space-between;
  margin-top: 14rpx;
  color: #5d5851;
  font-size: 18rpx;
}

.privacy-note {
  max-width: 490rpx;
}

.error-text {
  display: block;
  margin-top: 15rpx;
  color: #ca8073;
  font-size: 21rpx;
}

.sample-list {
  display: flex;
  flex-direction: column;
  gap: 11rpx;
  margin-top: 20rpx;
}

.sample {
  display: flex;
  align-items: center;
  gap: 15rpx;
  margin: 0;
  padding: 17rpx 20rpx;
  border: 0;
  color: #777168;
  font-size: 21rpx;
  line-height: 1.55;
  text-align: left;
  background: transparent;
}

.sample-mark {
  color: #947747;
}

.horizon-trigger {
  position: relative;
  display: flex;
  width: 154rpx;
  height: 154rpx;
  align-items: center;
  justify-content: center;
  margin: 36rpx auto 0;
  padding: 0;
  overflow: visible;
  border: 0;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(177, 133, 68, 0.08), transparent 66%);
  background-color: transparent !important;
  opacity: 0.28;
  transition: opacity 0.4s ease, transform 0.4s ease;
}

.horizon-trigger.is-ready {
  opacity: 1;
  animation: horizon-breathe 2.8s ease-in-out infinite;
}

.horizon-trigger:active {
  transform: scale(0.92);
}

.horizon-ring,
.horizon-stream,
.horizon-core {
  position: absolute;
  border-radius: 50%;
}

.horizon-ring {
  border: 1rpx solid rgba(212, 170, 100, 0.32);
}

.horizon-ring-outer {
  inset: 10rpx;
  animation: ring-turn 8s linear infinite;
}

.horizon-ring-inner {
  inset: 34rpx;
  border-color: rgba(232, 201, 148, 0.5);
  animation: ring-turn 5s linear infinite reverse;
}

.horizon-ring-outer::before,
.horizon-ring-inner::before {
  position: absolute;
  top: -4rpx;
  left: 50%;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #d3aa67;
  box-shadow: 0 0 18rpx rgba(211, 170, 103, 0.85);
  content: "";
}

.horizon-stream {
  width: 98rpx;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, rgba(205, 159, 88, 0.45), transparent);
  transform-origin: 50% 50%;
}

.horizon-stream-one {
  transform: rotate(0deg);
}

.horizon-stream-two {
  transform: rotate(60deg);
}

.horizon-stream-three {
  transform: rotate(120deg);
}

.horizon-core {
  display: flex;
  width: 54rpx;
  height: 54rpx;
  align-items: center;
  justify-content: center;
  color: #d9bd8c;
  font-family: "STSong", serif;
  font-size: 22rpx;
  background: #050505;
  box-shadow:
    inset 0 0 0 1rpx rgba(225, 190, 130, 0.5),
    0 0 36rpx rgba(194, 145, 69, 0.32);
}

.horizon-label {
  display: block;
  margin-top: 13rpx;
  color: #645d53;
  font-size: 19rpx;
  letter-spacing: 1rpx;
}

.session-intro {
  padding: 52rpx 40rpx 22rpx;
  text-align: center;
}

.session-kicker,
.frozen-question {
  display: block;
}

.frozen-question {
  max-width: 650rpx;
  margin: 22rpx auto 0;
  color: #b4aa9b;
  font-family: "STSong", serif;
  font-size: 27rpx;
  line-height: 1.75;
}

.session-rule {
  width: 1rpx;
  height: 56rpx;
  margin: 30rpx auto 0;
  background: linear-gradient(rgba(201, 158, 88, 0.48), transparent);
}

.planning {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 560rpx;
  padding: 38rpx 0 56rpx;
}

.convergence-field {
  position: relative;
  width: 330rpx;
  height: 330rpx;
}

.convergence-orbit,
.convergence-core,
.convergence-node {
  position: absolute;
  top: 50%;
  left: 50%;
  border-radius: 50%;
}

.convergence-orbit {
  border: 1rpx solid rgba(202, 158, 89, 0.18);
}

.convergence-orbit-one {
  width: 280rpx;
  height: 280rpx;
  margin: -140rpx;
  animation: ring-turn 7s linear infinite;
}

.convergence-orbit-two {
  width: 210rpx;
  height: 210rpx;
  margin: -105rpx;
  border-style: dashed;
  animation: ring-turn 4.8s linear infinite reverse;
}

.convergence-orbit-three {
  width: 130rpx;
  height: 130rpx;
  margin: -65rpx;
  animation: convergence-pulse 2s ease-in-out infinite;
}

.convergence-core {
  width: 48rpx;
  height: 48rpx;
  margin: -24rpx;
  background: #020202;
  box-shadow:
    0 0 0 1rpx rgba(231, 197, 137, 0.48),
    0 0 48rpx rgba(201, 155, 82, 0.46);
}

.convergence-node {
  width: 12rpx;
  height: 12rpx;
  margin: -6rpx;
  background: #bd965d;
  box-shadow: 0 0 18rpx rgba(189, 150, 93, 0.72);
}

.node-one {
  animation: node-one 3.2s ease-in-out infinite;
}

.node-two {
  animation: node-two 3.7s ease-in-out infinite -1.2s;
}

.node-three {
  animation: node-three 4.1s ease-in-out infinite -2.1s;
}

.planning-title {
  color: #c9bda9;
  font-family: "STSong", serif;
  font-size: 27rpx;
}

.planning-caption {
  margin-top: 11rpx;
  color: #625d56;
  font-size: 20rpx;
}

.ritual-stop {
  margin-top: 32rpx;
  padding: 8rpx 22rpx;
  color: #756d61;
  font-size: 19rpx;
  background: transparent;
}

.cards-section {
  padding-top: 24rpx;
}

.section-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 0 36rpx;
}

.section-kicker,
.section-title {
  display: block;
}

.section-title {
  margin-top: 10rpx;
  color: #d9cfc0;
  font-family: "STSong", serif;
  font-size: 35rpx;
}

.text-button {
  margin: 0;
  padding: 9rpx 14rpx;
  color: #746b5e;
  font-size: 19rpx;
  background: transparent;
}

.reveal-progress {
  margin: 28rpx 36rpx 26rpx;
}

.progress-copy {
  display: flex;
  justify-content: space-between;
  color: #5f5951;
  font-size: 18rpx;
}

.progress-track {
  display: flex;
  gap: 8rpx;
  margin-top: 12rpx;
}

.progress-segment {
  height: 2rpx;
  flex: 1;
  background: #292724;
  transition: background 0.5s ease, box-shadow 0.5s ease;
}

.progress-segment.is-complete {
  background: #6a5739;
}

.progress-segment.is-revealed {
  background: #d1ac70;
  box-shadow: 0 0 12rpx rgba(209, 172, 112, 0.45);
}

.card-rail {
  width: 100%;
  padding: 5rpx 0 32rpx;
  white-space: nowrap;
}

.oracle-card {
  position: relative;
  display: inline-block;
  width: 500rpx;
  height: 720rpx;
  box-sizing: border-box;
  margin-right: 22rpx;
  margin-bottom: 0;
  padding: 0;
  vertical-align: top;
  color: inherit;
  line-height: normal;
  text-align: left;
  background: transparent;
  perspective: 1400rpx;
  opacity: 0;
  transform: translateY(34rpx);
  animation: card-arrival 0.85s cubic-bezier(0.2, 0.72, 0.12, 1) forwards;
}

.arrival-0 {
  margin-left: 36rpx;
}

.arrival-2 {
  margin-right: 110rpx;
}

.arrival-1 {
  animation-delay: 0.09s;
}

.arrival-2 {
  animation-delay: 0.18s;
}

.card-flipper {
  position: relative;
  width: 100%;
  height: 100%;
  transform-style: preserve-3d;
  transition: transform 0.85s cubic-bezier(0.18, 0.76, 0.2, 1);
}

.oracle-card.is-revealed .card-flipper {
  transform: rotateY(180deg);
}

.card-face {
  position: absolute;
  inset: 0;
  box-sizing: border-box;
  overflow: hidden;
  border: 1rpx solid rgba(221, 195, 150, 0.16);
  border-radius: 5rpx 38rpx 5rpx 5rpx;
  backface-visibility: hidden;
  box-shadow: 0 38rpx 100rpx rgba(0, 0, 0, 0.5);
}

.card-front {
  background:
    radial-gradient(circle at 50% 42%, rgba(156, 117, 57, 0.13), transparent 34%),
    linear-gradient(150deg, #1c1a17, #0a0a09 72%);
}

.card-back {
  transform: rotateY(180deg);
  background:
    radial-gradient(circle at 50% 34%, rgba(181, 140, 75, 0.17), transparent 37%),
    linear-gradient(155deg, #242019, #090909 70%);
}

.card-index {
  position: absolute;
  top: 30rpx;
  left: 30rpx;
  color: rgba(220, 191, 139, 0.65);
  font-family: Georgia, serif;
  font-size: 24rpx;
  letter-spacing: 3rpx;
}

.card-grain {
  position: absolute;
  inset: 0;
  opacity: 0.14;
  background-image:
    linear-gradient(33deg, transparent 44%, rgba(255, 255, 255, 0.04) 45%, transparent 46%),
    linear-gradient(120deg, transparent 48%, rgba(255, 255, 255, 0.025) 49%, transparent 50%);
  background-size: 17rpx 21rpx, 23rpx 19rpx;
}

.card-seal {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 210rpx;
  height: 210rpx;
  transform: translate(-50%, -58%);
}

.seal-circle,
.persona-ring {
  position: absolute;
  border-radius: 50%;
}

.seal-circle-outer {
  inset: 0;
  border: 1rpx solid rgba(207, 165, 98, 0.34);
  animation: ring-turn 10s linear infinite;
}

.seal-circle-inner {
  inset: 42rpx;
  border: 1rpx dashed rgba(207, 165, 98, 0.4);
  animation: ring-turn 7s linear infinite reverse;
}

.seal-axis {
  position: absolute;
  top: 50%;
  left: 9%;
  width: 82%;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, rgba(207, 165, 98, 0.32), transparent);
}

.seal-axis-two {
  transform: rotate(90deg);
}

.seal-mark {
  position: absolute;
  top: 50%;
  left: 50%;
  color: #b9945c;
  font-family: "STSong", serif;
  font-size: 28rpx;
  transform: translate(-50%, -50%);
}

.oracle-card-streaming .seal-circle-outer,
.oracle-card-waiting .seal-circle-outer {
  animation-duration: 3.2s;
}

.oracle-card-streaming .seal-mark {
  animation: dot-breathe 1.2s ease-in-out infinite;
}

.oracle-card-ready .card-front {
  border-color: rgba(222, 183, 118, 0.32);
  box-shadow:
    0 38rpx 100rpx rgba(0, 0, 0, 0.52),
    0 0 44rpx rgba(193, 144, 69, 0.08);
}

.oracle-card-failed {
  opacity: 0.45;
}

.card-front-foot {
  position: absolute;
  right: 30rpx;
  bottom: 30rpx;
  left: 30rpx;
}

.sealed-name,
.sealed-caption {
  display: block;
}

.sealed-name {
  color: #b4aa99;
  font-family: "STSong", serif;
  font-size: 29rpx;
  letter-spacing: 4rpx;
}

.sealed-caption {
  margin-top: 8rpx;
  color: #5f584e;
  font-size: 14rpx;
  letter-spacing: 3rpx;
}

.card-aura {
  position: absolute;
  top: 78rpx;
  left: 50%;
  width: 320rpx;
  height: 320rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(204, 161, 92, 0.17), transparent 66%);
  transform: translateX(-50%);
}

.persona-sigil {
  position: absolute;
  top: 135rpx;
  left: 50%;
  display: flex;
  width: 190rpx;
  height: 190rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: #d4b57e;
  font-family: "STSong", serif;
  font-size: 78rpx;
  background: rgba(6, 6, 5, 0.58);
  box-shadow: inset 0 0 50rpx rgba(195, 147, 71, 0.08);
}

.persona-ring {
  inset: -18rpx;
  border: 1rpx solid rgba(218, 179, 115, 0.28);
  animation: ring-turn 12s linear infinite;
}

.persona-ring::before,
.persona-ring::after {
  position: absolute;
  top: 50%;
  left: -7rpx;
  width: 13rpx;
  height: 13rpx;
  margin-top: -6rpx;
  border-radius: 50%;
  background: #bb9256;
  box-shadow: 0 0 15rpx rgba(187, 146, 86, 0.6);
  content: "";
}

.persona-ring::after {
  right: -7rpx;
  left: auto;
}

.card-identity {
  position: absolute;
  right: 34rpx;
  bottom: 76rpx;
  left: 34rpx;
  white-space: normal;
}

.slot-label,
.persona-name,
.perspective-label {
  display: block;
}

.slot-label {
  color: #9d7b4c;
  font-size: 17rpx;
  letter-spacing: 4rpx;
}

.persona-name {
  margin-top: 13rpx;
  color: #eadfce;
  font-family: "STSong", serif;
  font-size: 38rpx;
  letter-spacing: 2rpx;
}

.perspective-label {
  margin-top: 10rpx;
  color: #7a7267;
  font-size: 21rpx;
}

.card-disclaimer {
  position: absolute;
  right: 30rpx;
  bottom: 26rpx;
  color: #4e4942;
  font-size: 14rpx;
  letter-spacing: 1rpx;
}

.interaction-guide {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 4rpx 36rpx 42rpx;
  color: #6a635a;
  font-size: 18rpx;
  text-align: center;
}

.guide-line {
  height: 1rpx;
  flex: 1;
  background: linear-gradient(90deg, transparent, rgba(190, 150, 88, 0.2));
}

.guide-line-right {
  transform: rotate(180deg);
}

.interrupted-panel,
.exit-panel,
.synthesis-card {
  margin: 28rpx 32rpx 0;
  padding: 32rpx;
  border-radius: 5rpx 28rpx 5rpx 5rpx;
}

.interrupted-title,
.interrupted-body,
.exit-kicker,
.exit-title,
.exit-description {
  display: block;
}

.interrupted-title {
  color: #c8bba7;
  font-size: 27rpx;
}

.interrupted-body {
  margin-top: 10rpx;
  color: #786f63;
  font-size: 21rpx;
}

.exit-panel {
  border-color: rgba(202, 161, 94, 0.22);
  animation: panel-rise 0.8s ease both;
}

.exit-kicker {
  color: #8e7045;
  font-size: 16rpx;
  letter-spacing: 4rpx;
}

.exit-title {
  margin-top: 13rpx;
  color: #dfd4c4;
  font-family: "STSong", serif;
  font-size: 34rpx;
  line-height: 1.5;
}

.exit-description {
  margin-top: 13rpx;
  color: #6f685f;
  font-size: 21rpx;
  line-height: 1.7;
}

.exit-actions {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 26rpx;
}

.exit-button {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin: 0;
  padding: 22rpx 21rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.055);
  border-radius: 4rpx 20rpx 4rpx 4rpx;
  text-align: left;
  background: rgba(255, 255, 255, 0.018);
}

.exit-number {
  color: #806640;
  font-family: Georgia, serif;
  font-size: 20rpx;
}

.exit-button-title,
.exit-button-caption {
  display: block;
}

.exit-button-title {
  color: #c9b99d;
  font-size: 24rpx;
}

.exit-button-caption {
  margin-top: 6rpx;
  color: #676159;
  font-size: 19rpx;
}

.synthesis-card {
  border-color: rgba(184, 143, 77, 0.28);
  background:
    radial-gradient(circle at 80% 10%, rgba(169, 127, 61, 0.13), transparent 38%),
    linear-gradient(145deg, rgba(49, 40, 27, 0.75), rgba(15, 15, 14, 0.96));
  animation: panel-rise 0.65s ease both;
}

.synthesis-title,
.synthesis-body {
  display: block;
}

.synthesis-title {
  margin-top: 14rpx;
  color: #e7dccb;
  font-family: "STSong", serif;
  font-size: 34rpx;
}

.synthesis-body {
  margin-top: 20rpx;
  color: #c8beae;
  font-size: 25rpx;
  line-height: 1.85;
}

.restart-button {
  margin-top: 30rpx;
  color: #877d6e;
  font-size: 22rpx;
  background: transparent;
}

.footer-note {
  padding: 58rpx 48rpx 24rpx;
  color: #49453f;
  font-size: 18rpx;
  line-height: 1.65;
  text-align: center;
}

.ingestion-layer,
.featured-layer,
.reading-layer {
  position: fixed;
  z-index: 40;
  inset: 0;
}

.ingestion-layer {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 52rpx;
  background:
    radial-gradient(circle at 50% 56%, rgba(145, 103, 43, 0.13), transparent 31%),
    rgba(4, 4, 4, 0.97);
  animation: veil-in 0.35s ease both;
}

.ingestion-label {
  color: #735c39;
  font-size: 14rpx;
  letter-spacing: 4rpx;
}

.ingestion-question {
  display: -webkit-box;
  max-width: 600rpx;
  margin-top: 28rpx;
  overflow: hidden;
  color: #a69a89;
  font-family: "STSong", serif;
  font-size: 27rpx;
  line-height: 1.7;
  text-align: center;
  opacity: 0;
  transform: scale(1.06);
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  animation: question-ingest 0.72s ease forwards;
}

.ingestion-horizon {
  position: relative;
  width: 270rpx;
  height: 270rpx;
  margin-top: 34rpx;
}

.ingestion-ring,
.ingestion-core {
  position: absolute;
  top: 50%;
  left: 50%;
  border-radius: 50%;
}

.ingestion-ring {
  border: 1rpx solid rgba(208, 164, 94, 0.26);
}

.ingestion-ring-one {
  width: 250rpx;
  height: 250rpx;
  margin: -125rpx;
  animation: ingestion-collapse 0.72s ease-in forwards;
}

.ingestion-ring-two {
  width: 180rpx;
  height: 180rpx;
  margin: -90rpx;
  animation: ingestion-collapse 0.72s 0.08s ease-in forwards;
}

.ingestion-ring-three {
  width: 104rpx;
  height: 104rpx;
  margin: -52rpx;
  animation: ingestion-collapse 0.72s 0.15s ease-in forwards;
}

.ingestion-core {
  width: 32rpx;
  height: 32rpx;
  margin: -16rpx;
  background: #000;
  box-shadow: 0 0 46rpx rgba(205, 157, 82, 0.56);
  animation: core-flash 0.72s ease-in forwards;
}

.ingestion-caption {
  margin-top: 20rpx;
  color: #7c7162;
  font-size: 20rpx;
  letter-spacing: 2rpx;
}

.ingestion-stop {
  margin-top: 20rpx;
}

.featured-layer {
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(2, 2, 2, 0.93);
  animation: veil-in 0.42s ease both;
}

.featured-stage {
  position: relative;
  width: 560rpx;
  height: 840rpx;
  margin: 0;
  padding: 0;
  overflow: visible;
  color: inherit;
  line-height: normal;
  background: transparent;
  animation: featured-rise 0.88s cubic-bezier(0.17, 0.76, 0.17, 1) both;
}

.featured-halo {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 580rpx;
  height: 580rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(201, 154, 82, 0.18), transparent 66%);
  transform: translate(-50%, -50%);
  animation: convergence-pulse 2.6s ease-in-out infinite;
}

.featured-card {
  position: absolute;
  inset: 0;
  box-sizing: border-box;
  padding: 54rpx 44rpx 42rpx;
  overflow: hidden;
  border: 1rpx solid rgba(223, 189, 130, 0.32);
  border-radius: 5rpx 42rpx 5rpx 5rpx;
  text-align: center;
  background:
    radial-gradient(circle at 50% 32%, rgba(193, 145, 70, 0.19), transparent 34%),
    linear-gradient(155deg, #242018, #070707 72%);
  box-shadow:
    0 55rpx 150rpx rgba(0, 0, 0, 0.8),
    0 0 70rpx rgba(190, 141, 67, 0.1);
}

.featured-ordinal {
  position: absolute;
  top: 33rpx;
  left: 36rpx;
  color: #97774b;
  font-family: Georgia, serif;
  font-size: 22rpx;
}

.featured-sigil {
  display: flex;
  width: 190rpx;
  height: 190rpx;
  align-items: center;
  justify-content: center;
  margin: 82rpx auto 0;
  border: 1rpx solid rgba(222, 181, 113, 0.28);
  border-radius: 50%;
  color: #d5b77f;
  font-family: "STSong", serif;
  font-size: 76rpx;
  background: rgba(0, 0, 0, 0.3);
  box-shadow:
    0 0 0 16rpx rgba(205, 160, 88, 0.025),
    0 0 60rpx rgba(205, 160, 88, 0.14);
}

.featured-slot,
.featured-name,
.featured-perspective,
.featured-reason,
.featured-enter {
  display: block;
}

.featured-slot {
  margin-top: 62rpx;
  color: #987648;
  font-size: 17rpx;
  letter-spacing: 4rpx;
}

.featured-name {
  margin-top: 16rpx;
  color: #eadfcd;
  font-family: "STSong", serif;
  font-size: 42rpx;
  letter-spacing: 2rpx;
}

.featured-perspective {
  margin-top: 10rpx;
  color: #81786c;
  font-size: 21rpx;
}

.featured-rule {
  width: 80rpx;
  height: 1rpx;
  margin: 30rpx auto;
  background: #7f623b;
}

.featured-reason {
  color: #82796c;
  font-size: 21rpx;
  line-height: 1.65;
}

.featured-enter {
  position: absolute;
  right: 0;
  bottom: 34rpx;
  left: 0;
  color: #b29464;
  font-size: 19rpx;
  letter-spacing: 1rpx;
}

.overlay-close {
  position: absolute;
  bottom: calc(28rpx + env(safe-area-inset-bottom));
  left: 50%;
  width: 62rpx;
  height: 62rpx;
  margin: 0;
  padding: 0;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 50%;
  color: #746c61;
  font-size: 28rpx;
  line-height: 60rpx;
  background: rgba(255, 255, 255, 0.025);
  transform: translateX(-50%);
}

.reading-layer {
  z-index: 50;
  overflow: hidden;
  background:
    radial-gradient(circle at 50% 20%, rgba(147, 107, 50, 0.12), transparent 32%),
    #070707;
  animation: reading-in 0.55s ease both;
}

.reading-top {
  position: absolute;
  z-index: 3;
  top: 0;
  right: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-right: 28rpx;
  padding-bottom: 14rpx;
  padding-left: 34rpx;
  background: linear-gradient(#070707 55%, transparent);
}

.reading-position {
  color: #746650;
  font-family: Georgia, serif;
  font-size: 19rpx;
  letter-spacing: 3rpx;
}

.reading-close {
  width: 62rpx;
  height: 62rpx;
  margin: 0;
  padding: 0;
  color: #938675;
  font-size: 31rpx;
  line-height: 62rpx;
  background: transparent;
}

.reading-scroll {
  width: 100%;
  height: 100vh;
}

.reading-room {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 160rpx 44rpx calc(88rpx + env(safe-area-inset-bottom));
}

.reading-monogram {
  display: flex;
  width: 104rpx;
  height: 104rpx;
  align-items: center;
  justify-content: center;
  margin: 0 auto 30rpx;
  border: 1rpx solid rgba(208, 167, 99, 0.24);
  border-radius: 50%;
  color: #c5a56e;
  font-family: "STSong", serif;
  font-size: 44rpx;
  background: rgba(193, 145, 70, 0.04);
  box-shadow: 0 0 50rpx rgba(193, 145, 70, 0.08);
}

.reading-kicker,
.reading-title,
.reading-subtitle {
  display: block;
  text-align: center;
}

.reading-title {
  margin-top: 18rpx;
  color: #e9dfd0;
  font-family: "STSong", serif;
  font-size: 40rpx;
  line-height: 1.5;
}

.reading-subtitle {
  margin-top: 12rpx;
  color: #6f685e;
  font-size: 19rpx;
}

.reading-question,
.reading-reason,
.reading-verdict {
  margin-top: 48rpx;
}

.reading-question,
.reading-reason {
  padding: 26rpx 28rpx;
  border-left: 1rpx solid rgba(196, 153, 84, 0.28);
  color: #8c8376;
  font-size: 23rpx;
  line-height: 1.75;
  background: linear-gradient(90deg, rgba(188, 143, 71, 0.045), transparent);
}

.reading-section-label {
  display: block;
  margin-bottom: 15rpx;
}

.reading-verdict {
  position: relative;
  padding: 50rpx 24rpx;
  border-top: 1rpx solid rgba(209, 169, 104, 0.2);
  border-bottom: 1rpx solid rgba(209, 169, 104, 0.2);
}

.reading-verdict::before {
  position: absolute;
  top: 26rpx;
  right: 18rpx;
  color: rgba(205, 165, 99, 0.1);
  font-family: Georgia, serif;
  font-size: 90rpx;
  content: "“";
}

.reading-body {
  display: block;
  color: #d5cbbd;
  font-family: "STSong", serif;
  font-size: 29rpx;
  line-height: 2;
  letter-spacing: 1rpx;
}

.reading-navigation {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
  margin-top: 56rpx;
  color: #555049;
  font-size: 16rpx;
  text-align: center;
}

.reading-nav {
  margin: 0;
  padding: 12rpx 9rpx;
  color: #9b896c;
  font-size: 19rpx;
  background: transparent;
  background-color: transparent !important;
}

.reading-nav.is-disabled {
  color: #3d3a36;
}

.reading-disclaimer {
  display: block;
  margin-top: 54rpx;
  color: #46423d;
  font-size: 17rpx;
  line-height: 1.6;
  text-align: center;
}

@keyframes star-breathe {
  0%,
  100% {
    opacity: 0.18;
    transform: scale(0.8);
  }
  50% {
    opacity: 0.9;
    transform: scale(1.5);
  }
}

@keyframes horizon-breathe {
  0%,
  100% {
    filter: brightness(0.86);
  }
  50% {
    filter: brightness(1.2);
  }
}

@keyframes ring-turn {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}

@keyframes convergence-pulse {
  0%,
  100% {
    opacity: 0.42;
    transform: scale(0.9);
  }
  50% {
    opacity: 1;
    transform: scale(1.08);
  }
}

@keyframes node-one {
  0%,
  100% {
    transform: translate(-124rpx, -42rpx);
  }
  50% {
    transform: translate(78rpx, 108rpx);
  }
}

@keyframes node-two {
  0%,
  100% {
    transform: translate(110rpx, -78rpx);
  }
  50% {
    transform: translate(-72rpx, 96rpx);
  }
}

@keyframes node-three {
  0%,
  100% {
    transform: translate(36rpx, 126rpx);
  }
  50% {
    transform: translate(-104rpx, -72rpx);
  }
}

@keyframes dot-breathe {
  0%,
  100% {
    opacity: 0.25;
  }
  50% {
    opacity: 1;
  }
}

@keyframes card-arrival {
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes panel-rise {
  from {
    opacity: 0;
    transform: translateY(28rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes veil-in {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes question-ingest {
  0% {
    opacity: 0;
    transform: scale(1.06);
  }
  35% {
    opacity: 0.85;
  }
  100% {
    opacity: 0;
    transform: scale(0.18);
  }
}

@keyframes ingestion-collapse {
  0% {
    opacity: 0.25;
    transform: scale(1.15) rotate(0deg);
  }
  55% {
    opacity: 1;
  }
  100% {
    opacity: 0;
    transform: scale(0.08) rotate(120deg);
  }
}

@keyframes core-flash {
  0% {
    transform: scale(0.7);
  }
  65% {
    transform: scale(1.45);
    box-shadow: 0 0 64rpx rgba(223, 179, 110, 0.76);
  }
  100% {
    transform: scale(0.25);
  }
}

@keyframes featured-rise {
  from {
    opacity: 0;
    transform: translateY(80rpx) scale(0.76) rotateY(-12deg);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1) rotateY(0);
  }
}

@keyframes reading-in {
  from {
    opacity: 0;
    transform: scale(1.025);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}
