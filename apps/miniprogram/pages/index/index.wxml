<view
  class="page-shell phase-{{phase}} spectrum-{{spectrumId}} energy-{{questionEnergy}} {{isQuestionFocused ? 'question-focused' : ''}} {{focusedCard ? 'is-reading' : ''}}"
  style="{{spectrumStyle}}"
>
  <image
    class="nebula-veil"
    src="/assets/atmosphere/nebula-veil.webp"
    mode="aspectFill"
    aria-hidden="true"
  ></image>
  <canvas
    id="oracle-sky"
    type="2d"
    class="oracle-sky"
    aria-hidden="true"
  ></canvas>
  <view class="cosmos" aria-hidden="true">
    <view class="spectral-orbit spectral-orbit-one"></view>
    <view class="spectral-orbit spectral-orbit-two"></view>
    <view class="cosmic-horizon">
      <view class="cosmic-horizon-ring"></view>
      <view class="cosmic-horizon-core"></view>
    </view>
    <view class="cosmos-vignette"></view>
  </view>
  <view class="star-field" aria-hidden="true">
    <view class="star star-one"></view>
    <view class="star star-two"></view>
    <view class="star star-three"></view>
    <view class="star star-four"></view>
    <view class="star star-five"></view>
    <view class="star star-six"></view>
  </view>
  <view class="ambient ambient-one"></view>
  <view class="ambient ambient-two"></view>

  <view class="topbar" style="padding-top: {{statusBarHeight}}px;">
    <button class="brand" bindtap="onReset" aria-label="返回新问题">
      <text class="brand-mark">职</text>
      <text class="brand-name">职乎</text>
    </button>
    <button
      wx:if="{{hasHistory && phase === 'idle' && !isQuestionFocused}}"
      class="history-button"
      bindtap="onOpenHistory"
      aria-label="打开历史"
    >◫</button>
  </view>

  <view class="content">
    <block wx:if="{{phase === 'idle' || phase === 'ingesting'}}">
      <view class="idle-scene">
        <view class="hero">
          <text class="eyebrow">ONE QUESTION · DIFFERENT TRUTHS</text>
          <text class="hero-title">把你的困惑，</text>
          <text class="hero-title hero-title-indent">交给不同的人生。</text>
        </view>

        <view class="question-stage">
          <view class="question-panel">
            <view class="question-focus-line question-focus-line-top"></view>
            <textarea
              class="question-input"
              value="{{question}}"
              maxlength="1000"
              auto-height="{{false}}"
              placeholder="…"
              placeholder-class="question-placeholder"
              bindinput="onQuestionInput"
              bindfocus="onQuestionFocus"
              bindblur="onQuestionBlur"
            ></textarea>
            <view class="question-focus-line question-focus-line-bottom"></view>
            <text wx:if="{{charCount > 850}}" class="question-limit">{{charCount}} / 1000</text>
            <text wx:if="{{error}}" class="error-text">{{error}}</text>
          </view>

          <button
            class="horizon-trigger {{canSubmit ? 'is-ready' : ''}} {{isHoldingQuestion ? 'is-holding' : ''}} {{holdInterrupted ? 'is-interrupted' : ''}}"
            disabled="{{!canSubmit}}"
            bindtouchstart="onQuestionHoldStart"
            bindtouchend="onQuestionHoldEnd"
            bindtouchcancel="onQuestionHoldEnd"
            aria-label="长按投入问题"
          >
            <view class="horizon-ring horizon-ring-outer"></view>
            <view class="horizon-ring horizon-ring-inner"></view>
            <view class="gravity-feeds" aria-hidden="true">
              <view class="gravity-feed gravity-feed-01"><view class="gravity-feed-ray"></view></view>
              <view class="gravity-feed gravity-feed-02"><view class="gravity-feed-ray"></view></view>
              <view class="gravity-feed gravity-feed-03"><view class="gravity-feed-ray"></view></view>
              <view class="gravity-feed gravity-feed-04"><view class="gravity-feed-ray"></view></view>
              <view class="gravity-feed gravity-feed-05"><view class="gravity-feed-ray"></view></view>
              <view class="gravity-feed gravity-feed-06"><view class="gravity-feed-ray"></view></view>
              <view class="gravity-feed gravity-feed-07"><view class="gravity-feed-ray"></view></view>
              <view class="gravity-feed gravity-feed-08"><view class="gravity-feed-ray"></view></view>
              <view class="gravity-feed gravity-feed-09"><view class="gravity-feed-ray"></view></view>
              <view class="gravity-feed gravity-feed-10"><view class="gravity-feed-ray"></view></view>
            </view>
            <view class="horizon-core"></view>
          </button>
          <view
            wx:if="{{canSubmit && showHoldHint && !isHoldingQuestion}}"
            class="horizon-cue"
            aria-hidden="true"
          >
            <view class="horizon-cue-grain"></view>
          </view>
        </view>
      </view>
    </block>

    <block wx:else>
      <view wx:if="{{phase !== 'planning'}}" class="session-intro">
        <text class="frozen-question">{{question}}</text>
        <view class="session-rule"></view>
      </view>

      <view wx:if="{{phase === 'planning'}}" class="planning">
        <button class="ritual-stop" bindtap="onStop" aria-label="停止">×</button>
      </view>

      <view wx:if="{{cards.length && cardsVisible}}" class="cards-section">
        <button
          wx:if="{{isRunning}}"
          class="text-button card-stage-stop"
          bindtap="onStop"
          aria-label="停止"
        >×</button>

        <scroll-view
          class="card-rail"
          scroll-x
          enhanced
          paging-enabled="{{true}}"
          show-scrollbar="{{false}}"
          enable-flex
          bindscroll="onCardRailScroll"
        >
          <view
            wx:for="{{cards}}"
            wx:key="id"
            class="card-slide"
          >
            <button
              class="oracle-card constellation-{{item.constellation}} oracle-card-{{item.status}} {{item.isRevealed ? 'is-revealed' : 'is-sealed'}} {{enteringCardId === item.id ? 'is-entering' : ''}} {{cardSignalId === item.id ? 'is-signaled' : ''}} arrival-{{index}}"
              style="{{item.cardStyle}}"
              data-index="{{index}}"
              bindtap="onCardTap"
              aria-label="{{item.isRevealed ? '进入' + item.persona.displayName + '的判断' : '显影第' + (index + 1) + '张判断卡'}}"
            >
              <view class="card-flipper">
                <view class="card-face card-front">
                  <view class="card-edge-frame"></view>
                  <view class="card-corner corner-nw"></view>
                  <view class="card-corner corner-ne"></view>
                  <view class="card-corner corner-sw"></view>
                  <view class="card-corner corner-se"></view>
                  <text class="card-index">{{item.ordinal}}</text>
                  <view class="card-grain"></view>
                  <view class="card-constellation">
                    <view class="constellation-line line-one"></view>
                    <view class="constellation-line line-two"></view>
                    <view class="constellation-line line-three"></view>
                    <view class="constellation-star constellation-star-one"></view>
                    <view class="constellation-star constellation-star-two"></view>
                    <view class="constellation-star constellation-star-three"></view>
                    <view class="constellation-star constellation-star-four"></view>
                  </view>
                  <view class="card-seal">
                    <view class="seal-orbit seal-orbit-one"></view>
                    <view class="seal-orbit seal-orbit-two"></view>
                    <view class="seal-circle seal-circle-outer"></view>
                    <view class="seal-circle seal-circle-inner"></view>
                    <view class="seal-diamond"></view>
                    <view class="seal-axis seal-axis-one"></view>
                    <view class="seal-axis seal-axis-two"></view>
                    <view class="seal-gem"></view>
                    <text class="seal-glyph">{{item.sealGlyph}}</text>
                  </view>
                  <view class="card-front-foot">
                    <text class="sealed-name">{{item.status === 'failed' ? '封印未成' : item.status === 'cancelled' ? '未显之牌' : '无名之牌'}}</text>
                  </view>
                  <text
                    wx:if="{{cardSignalId === item.id}}"
                    class="card-state-signal"
                  >{{cardSignalText}}</text>
                  <view
                    wx:if="{{item.status === 'failed'}}"
                    class="card-retry"
                    data-index="{{index}}"
                    catchtap="onRetryCard"
                  >重试</view>
                </view>

                <view class="card-face card-back">
                  <view class="card-edge-frame"></view>
                  <view class="card-corner corner-nw"></view>
                  <view class="card-corner corner-ne"></view>
                  <view class="card-corner corner-sw"></view>
                  <view class="card-corner corner-se"></view>
                  <text class="card-index">{{item.ordinal}}</text>
                  <view class="card-grain"></view>
                  <view class="portrait-field">
                    <image
                      wx:if="{{item.imageSrc}}"
                      class="portrait-image"
                      src="{{item.imageSrc}}"
                      mode="aspectFill"
                      aria-hidden="true"
                    ></image>
                    <view wx:else class="portrait-silhouette">
                      <view class="portrait-head"></view>
                      <view class="portrait-shoulders"></view>
                      <text class="portrait-monogram">{{item.monogram}}</text>
                    </view>
                    <view class="portrait-ray portrait-ray-one"></view>
                    <view class="portrait-ray portrait-ray-two"></view>
                    <view class="portrait-ray portrait-ray-three"></view>
                    <view class="portrait-halo portrait-halo-outer"></view>
                    <view class="portrait-halo portrait-halo-inner"></view>
                    <view class="portrait-diamond"></view>
                    <view class="portrait-stars">
                      <view class="portrait-star portrait-star-one"></view>
                      <view class="portrait-star portrait-star-two"></view>
                      <view class="portrait-star portrait-star-three"></view>
                    </view>
                  </view>
                  <view class="card-identity">
                    <text class="identity-slot">{{item.slotLabel}} · {{item.ordinal}}</text>
                    <text class="persona-name">{{item.persona.displayName}}</text>
                    <text class="perspective-label">{{item.persona.perspectiveLabel}}</text>
                  </view>
                </view>
              </view>
            </button>
          </view>
        </scroll-view>
      </view>

      <view wx:if="{{phase === 'stopped' || phase === 'error'}}" class="interrupted-panel">
        <text class="interrupted-title">{{phase === 'error' ? '连接没有完成' : '本轮显影已停止'}}</text>
        <text class="interrupted-body">{{error || '已经抵达的内容仍然可以阅读。'}}</text>
      </view>

      <view wx:if="{{phase === 'ready' && allCardsRevealed}}" class="exit-panel">
        <text class="exit-title">三种声音之后，只带走一个下一步</text>
        <view class="exit-actions">
          <button class="exit-button" data-mode="decision" bindtap="onSynthesize" disabled="{{isSynthesizing}}">
            <text class="exit-button-title">{{isSynthesizing ? '正在收束' : '形成判断'}}</text>
          </button>
          <button class="exit-button" data-mode="communication" bindtap="onSynthesize" disabled="{{isSynthesizing}}">
            <text class="exit-button-title">{{isSynthesizing ? '请稍候' : '组织表达'}}</text>
          </button>
        </view>
      </view>

      <view wx:if="{{synthesisBody}}" class="synthesis-card">
        <text class="synthesis-title">{{synthesisTitle}}</text>
        <text class="synthesis-body" user-select="true">{{synthesisBody}}</text>
        <text class="synthesis-meta">{{synthesisMeta}}</text>
      </view>

      <button
        wx:if="{{phase === 'ready' || phase === 'stopped' || phase === 'error'}}"
        class="restart-button"
        bindtap="onReset"
      >新问</button>
    </block>
  </view>

  <view wx:if="{{sceneNotice}}" class="scene-notice" aria-live="polite">
    <view class="scene-notice-gem"></view>
    <text>{{sceneNotice}}</text>
  </view>

  <view wx:if="{{featuredCard}}" class="featured-layer {{featuredCardEntering ? 'is-entering' : ''}}" style="{{featuredCard.cardStyle}}" bindtap="onDismissFeatured">
    <button class="featured-stage" style="{{featuredOriginStyle}}" catchtap="onEnterFeatured" aria-label="进入{{featuredCard.persona.displayName}}的判词">
      <view class="featured-halo"></view>
      <view class="featured-card">
        <view class="card-edge-frame"></view>
        <view class="card-corner corner-nw"></view>
        <view class="card-corner corner-ne"></view>
        <view class="card-corner corner-sw"></view>
        <view class="card-corner corner-se"></view>
        <view class="card-grain"></view>
        <text class="featured-ordinal">{{featuredCard.ordinal}}</text>
        <view class="featured-portrait">
          <image
            wx:if="{{featuredCard.imageSrc}}"
            class="portrait-image"
            src="{{featuredCard.imageSrc}}"
            mode="aspectFill"
            aria-hidden="true"
          ></image>
          <view wx:else class="portrait-silhouette">
            <view class="portrait-head"></view>
            <view class="portrait-shoulders"></view>
            <text class="portrait-monogram">{{featuredCard.monogram}}</text>
          </view>
          <view class="portrait-ray portrait-ray-one"></view>
          <view class="portrait-ray portrait-ray-two"></view>
          <view class="portrait-ray portrait-ray-three"></view>
          <view class="portrait-halo portrait-halo-outer"></view>
          <view class="portrait-halo portrait-halo-inner"></view>
          <view class="portrait-diamond"></view>
        </view>
        <text class="featured-name">{{featuredCard.persona.displayName}}</text>
        <text class="featured-perspective">{{featuredCard.persona.perspectiveLabel}}</text>
        <text class="featured-reason">{{featuredCard.summoningLine}}</text>
      </view>
    </button>
    <button class="overlay-close" catchtap="onDismissFeatured" aria-label="收起">×</button>
  </view>

  <view
    wx:if="{{focusedCard}}"
    class="reading-layer safe-bottom {{readingMotion}}"
    style="{{focusedCard.cardStyle}}"
    bindtouchstart="onReadingTouchStart"
    bindtouchend="onReadingTouchEnd"
  >
    <view class="reading-top" style="padding-top: {{statusBarHeight}}px;">
      <text class="reading-position">{{focusedCardPosition}}</text>
      <button class="reading-close" bindtap="onCloseReading" aria-label="关闭阅读">×</button>
    </view>
    <scroll-view class="reading-scroll" scroll-y enhanced show-scrollbar="{{false}}">
      <view class="reading-room">
        <view wx:if="{{focusedCard.imageSrc}}" class="reading-avatar">
          <image
            class="reading-avatar-image"
            src="{{focusedCard.imageSrc}}"
            mode="aspectFill"
            aria-hidden="true"
          ></image>
          <view class="reading-avatar-shade"></view>
        </view>
        <view wx:else class="reading-monogram">
          <text>{{focusedCard.monogram}}</text>
        </view>
        <text class="reading-kicker">THE SUMMONED VOICE · {{focusedCard.ordinal}}</text>
        <text class="reading-title">{{focusedCard.persona.displayName}}，应此问而来</text>

        <view class="reading-question">
          <text>{{question}}</text>
        </view>

        <text wx:if="{{focusedReading.invocation}}" class="reading-invocation">{{focusedReading.invocation}}</text>

        <view class="reading-verdict">
          <text class="reading-section-label">THE VERDICT · 判词</text>
          <text class="reading-verdict-text" user-select="true">{{focusedReading.verdict}}</text>
          <view class="verdict-point"></view>
        </view>

        <view wx:if="{{focusedReading.exegesis.length}}" class="reading-exegesis">
          <text class="reading-section-label">EXEGESIS · 释义</text>
          <text
            wx:for="{{focusedReading.exegesis}}"
            wx:key="index"
            class="reading-body"
            style="animation-delay: {{item.revealDelayMs}}ms;"
            user-select="true"
          >{{item.text}}</text>
        </view>

        <view class="reading-navigation">
          <button
            class="reading-nav {{!canReadPrevious ? 'is-disabled' : ''}}"
            disabled="{{!canReadPrevious}}"
            bindtap="onReadPrevious"
            aria-label="上一张"
          >‹</button>
          <text>◇</text>
          <button
            class="reading-nav {{!canReadNext ? 'is-disabled' : ''}}"
            disabled="{{!canReadNext}}"
            bindtap="onReadNext"
            aria-label="下一张"
          >›</button>
        </view>
      </view>
    </scroll-view>
  </view>
</view>
