.history-page {
  position: relative;
  min-height: 100vh;
  padding: 0 32rpx 80rpx;
  box-sizing: border-box;
  background:
    radial-gradient(circle at 86% -4%, rgba(177, 132, 68, 0.12), transparent 29%),
    linear-gradient(180deg, #0d0c0a, #060707 54%, #050505);
}

.history-space {
  position: fixed;
  z-index: 0;
  inset: 0;
  overflow: hidden;
  pointer-events: none;
}

.history-nebula {
  position: absolute;
  border-radius: 50%;
  filter: blur(72rpx);
}

.history-nebula-one {
  top: 4%;
  right: -32%;
  width: 620rpx;
  height: 760rpx;
  background: rgba(135, 91, 48, 0.11);
  transform: rotate(-18deg);
}

.history-nebula-two {
  top: 45%;
  left: -46%;
  width: 720rpx;
  height: 880rpx;
  background: rgba(48, 82, 78, 0.085);
  transform: rotate(24deg);
}

.history-star-map {
  position: absolute;
  inset: 0;
  opacity: 0.38;
  background-image:
    radial-gradient(circle at 12% 16%, rgba(236, 219, 185, 0.75) 0 1rpx, transparent 2rpx),
    radial-gradient(circle at 72% 9%, rgba(236, 219, 185, 0.42) 0 1rpx, transparent 2rpx),
    radial-gradient(circle at 84% 31%, rgba(160, 191, 188, 0.62) 0 1rpx, transparent 2rpx),
    radial-gradient(circle at 28% 42%, rgba(236, 219, 185, 0.38) 0 1rpx, transparent 2rpx),
    radial-gradient(circle at 63% 57%, rgba(206, 180, 136, 0.5) 0 1rpx, transparent 2rpx),
    radial-gradient(circle at 16% 73%, rgba(160, 191, 188, 0.48) 0 1rpx, transparent 2rpx),
    radial-gradient(circle at 91% 86%, rgba(236, 219, 185, 0.5) 0 1rpx, transparent 2rpx),
    radial-gradient(circle at 42% 94%, rgba(236, 219, 185, 0.32) 0 1rpx, transparent 2rpx);
}

.history-vignette {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(180deg, transparent 55%, rgba(0, 0, 0, 0.46)),
    radial-gradient(ellipse at 50% 32%, transparent 28%, rgba(0, 0, 0, 0.44) 100%);
}

.history-head,
.history-topbar,
.empty-state,
.history-list {
  position: relative;
  z-index: 1;
}

.history-topbar {
  display: flex;
  align-items: center;
  height: 72rpx;
}

.history-back {
  flex: 0 0 58rpx;
  width: 58rpx;
  min-width: 58rpx;
  max-width: 58rpx;
  height: 58rpx;
  margin-top: 0;
  margin-right: auto !important;
  margin-bottom: 0;
  margin-left: 0 !important;
  padding: 0;
  border: 0;
  color: rgba(231, 222, 208, 0.7);
  font-family: Georgia, serif;
  font-size: 48rpx;
  line-height: 54rpx;
  background: transparent;
}

.history-back::after {
  border: 0;
}

.history-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 22rpx;
}

.history-kicker,
.history-title {
  display: block;
}

.history-kicker {
  color: #96794f;
  font-size: 18rpx;
  letter-spacing: 5rpx;
}

.history-title {
  margin-top: 12rpx;
  color: #eee3d3;
  font-family: var(--font-serif);
  font-size: 44rpx;
}

.clear-button,
.delete-button {
  margin: 0;
  color: #8e766d;
  font-size: 22rpx;
  background: transparent;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 190rpx;
}

.empty-seal {
  position: relative;
  width: 118rpx;
  height: 118rpx;
  opacity: 0.48;
}

.empty-seal-orbit,
.empty-seal-diamond,
.empty-seal-gem {
  position: absolute;
  top: 50%;
  left: 50%;
}

.empty-seal-orbit {
  border: 1rpx solid #7a6546;
  border-radius: 50%;
  transform: translate(-50%, -50%);
}

.empty-seal-orbit-one {
  width: 110rpx;
  height: 52rpx;
  transform: translate(-50%, -50%) rotate(18deg);
}

.empty-seal-orbit-two {
  width: 68rpx;
  height: 98rpx;
  border-color: #5c5141;
  transform: translate(-50%, -50%) rotate(-28deg);
}

.empty-seal-diamond {
  width: 34rpx;
  height: 34rpx;
  border: 1rpx solid #8a704a;
  transform: translate(-50%, -50%) rotate(45deg);
}

.empty-seal-gem {
  width: 6rpx;
  height: 6rpx;
  background: #9d8054;
  box-shadow: 0 0 18rpx rgba(157, 128, 84, 0.36);
  transform: translate(-50%, -50%) rotate(45deg);
}

.empty-title {
  margin-top: 26rpx;
  color: #bcb09f;
  font-size: 28rpx;
}

.empty-caption {
  margin-top: 14rpx;
  color: #5c5751;
  font-size: 21rpx;
}

.history-list {
  margin-top: 42rpx;
}

.history-item {
  position: relative;
  margin-bottom: 20rpx;
  overflow: hidden;
  border: 1rpx solid var(--history-border);
  border-radius: 5rpx 30rpx 5rpx 5rpx;
  background:
    radial-gradient(circle at 88% 8%, var(--history-glow), transparent 34%),
    linear-gradient(145deg, var(--history-surface), rgba(8, 9, 9, 0.94));
  box-shadow:
    inset 0 0 0 1rpx rgba(255, 255, 255, 0.012),
    0 20rpx 66rpx rgba(0, 0, 0, 0.24);
}

.history-item::before {
  position: absolute;
  top: 0;
  right: 0;
  width: 96rpx;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, var(--history-accent));
  content: "";
  opacity: 0.58;
}

.history-summary {
  padding: 28rpx;
}

.history-meta {
  display: flex;
  justify-content: space-between;
  color: #6d675f;
  font-size: 19rpx;
}

.history-question {
  display: block;
  margin-top: 18rpx;
  color: #ded4c6;
  font-size: 27rpx;
  line-height: 1.65;
}

.persona-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx 22rpx;
  margin-top: 20rpx;
}

.persona-chip {
  padding: 7rpx 0 5rpx;
  border-bottom: 1rpx solid var(--history-border);
  color: var(--history-accent);
  font-size: 18rpx;
  background: transparent;
  opacity: 0.72;
}

.history-detail {
  padding: 0 28rpx 28rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.05);
}

.history-card,
.history-synthesis {
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}

.history-card-name,
.history-card-body {
  display: block;
}

.history-card-name {
  color: #aa8a5b;
  font-size: 21rpx;
}

.history-card-body {
  margin-top: 12rpx;
  color: #afa79b;
  font-size: 23rpx;
  line-height: 1.75;
}

.delete-button {
  margin-top: 22rpx;
}

.clear-button.is-confirming,
.delete-button.is-confirming {
  color: #b27668;
  letter-spacing: 1rpx;
}
