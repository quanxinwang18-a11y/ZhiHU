<view class="history-page safe-bottom">
  <view class="history-head">
    <view>
      <text class="history-kicker">LOCAL VAULT</text>
      <text class="history-title">只保存在这台设备</text>
    </view>
    <button wx:if="{{runs.length}}" class="clear-button" bindtap="onClear">清空</button>
  </view>
  <text class="history-intro">当前最多保留 20 条。删除后服务端无法替你恢复。</text>

  <view wx:if="{{!runs.length}}" class="empty-state">
    <text class="empty-symbol">○</text>
    <text class="empty-title">还没有留下判断</text>
    <text class="empty-caption">完成一次三卡显影后，记录会自动保存在这里。</text>
  </view>

  <view wx:else class="history-list">
    <view wx:for="{{runs}}" wx:key="id" class="history-item">
      <view class="history-summary" data-id="{{item.id}}" bindtap="onToggle">
        <view class="history-meta">
          <text>{{item.dateLabel}}</text>
          <text>{{item.cards.length}} 张卡</text>
        </view>
        <text class="history-question">{{item.question}}</text>
        <view class="persona-row">
          <text
            wx:for="{{item.cards}}"
            wx:for-item="card"
            wx:key="id"
            class="persona-chip"
          >{{card.persona.displayName}}</text>
        </view>
      </view>

      <view wx:if="{{expandedId === item.id}}" class="history-detail">
        <view wx:for="{{item.cards}}" wx:for-item="card" wx:key="id" class="history-card">
          <text class="history-card-name">{{card.persona.displayName}}</text>
          <text class="history-card-body" user-select="true">{{card.body}}</text>
        </view>
        <view wx:if="{{item.synthesisBody}}" class="history-synthesis">
          <text class="history-card-name">{{item.synthesisTitle}}</text>
          <text class="history-card-body" user-select="true">{{item.synthesisBody}}</text>
        </view>
        <button class="delete-button" data-id="{{item.id}}" bindtap="onDelete">删除这条记录</button>
      </view>
    </view>
  </view>
</view>

